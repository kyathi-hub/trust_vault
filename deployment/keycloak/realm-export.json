{
  "realm": "trustvault",
  "enabled": true,
  "displayName": "TrustVault",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "clients": [
    {
      "clientId": "trustvault-frontend",
      "name": "TrustVault Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "https://localhost/*",
        "http://localhost:5173/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:5173",
        "http://localhost"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "trustvault-api",
      "name": "TrustVault API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@trustvault.local",
      "firstName": "TrustVault",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin1234!",
          "temporary": true
        }
      ],
      "attributes": {
        "trustvault_subject": ["demo-admin-subject"]
      }
    },
    {
      "username": "alice",
      "email": "alice@trustvault.local",
      "firstName": "Alice",
      "lastName": "Owner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Alice1234!",
          "temporary": true
        }
      ],
      "attributes": {
        "trustvault_subject": ["demo-alice-subject"]
      }
    },
    {
      "username": "bob",
      "email": "bob@trustvault.local",
      "firstName": "Bob",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Bob12345!",
          "temporary": true
        }
      ],
      "attributes": {
        "trustvault_subject": ["demo-bob-subject"]
      }
    },
    {
      "username": "carol",
      "email": "carol@trustvault.local",
      "firstName": "Carol",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Carol123!",
          "temporary": true
        }
      ],
      "attributes": {
        "trustvault_subject": ["demo-carol-subject"]
      }
    }
  ],
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername()"
}
