# # TrustVault — Environment Variable Template
# # Copy this to .env and fill in real values.
# # NEVER commit .env to Git.
# # NEVER use these placeholder values in production.

# # ── Application ──────────────────────────────────────────────────────────────
# APP_ENV=development
# # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# APP_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# # Public hostname for TLS and Keycloak callbacks
# PUBLIC_HOSTNAME=localhost

# # ── PostgreSQL ────────────────────────────────────────────────────────────────
# # Superuser password (used by docker-compose for init only)
# POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# # Application-level DB password (least-privilege role: trustvault_app)
# APP_DB_PASSWORD=CHANGE_ME_strong_app_db_password

# # ── Keycloak ──────────────────────────────────────────────────────────────────
# KEYCLOAK_DB_PASSWORD=CHANGE_ME_strong_keycloak_db_password
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_keycloak_admin_password

# # ── MinIO ─────────────────────────────────────────────────────────────────────
# # Root credentials (admin — not used by the app directly)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_root_password

# # Application service account credentials (used by backend)
# MINIO_APP_ACCESS_KEY=CHANGE_ME_minio_app_access_key
# MINIO_APP_SECRET_KEY=CHANGE_ME_minio_app_secret_key

# # ── Encryption ───────────────────────────────────────────────────────────────
# # Master Key Encryption Key — MUST be base64-encoded 32 bytes
# # Generate with:
# #   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# # BACK THIS UP SECURELY. Losing this key means losing access to all encrypted documents.
# ENCRYPTION_KEK=CHANGE_ME_base64_encoded_32_bytes
# ENCRYPTION_KEK_VERSION=v1

# # ── Optional services ─────────────────────────────────────────────────────────
# CLAMAV_ENABLED=false
# OLLAMA_ENABLED=false

# # ── ACME/TLS (production only) ────────────────────────────────────────────────
# ACME_EMAIL=admin@yourdomain.com

